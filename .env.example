# =============================================================================
# N-Signage — copy to `.env` (git-ignored) and fill in. NO real values here.
# `.env` is the ONE local secrets file. Vercel does not read it: deployed values
# go in Vercel → Project → Settings → Environment Variables (Production).
# =============================================================================

# Website runtime database connection: Supabase transaction pooler (port 6543)
# as the restricted role nsignage_api. Same value in Vercel → Production.
DATABASE_URL=postgresql://nsignage_api.<project-ref>:<password>@<pooler-host>:6543/postgres

# Project-owner connection (session pooler, port 5432). ONLY for `npm run db:setup`.
# NEVER add this to Vercel.
SUPABASE_ADMIN_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Authorises the daily cleanup job (/api/cron/cleanup). Same value in Vercel → Production.
CRON_SECRET=

# Vercel Blob read-write token (temporary media relay only). Created by connecting
# a Blob store to the Vercel project; copy it here for local media-upload testing.
BLOB_READ_WRITE_TOKEN=

# Automated real-database tests (npm run test:supabase) write to the shared database.
# Keep 0; set 1 only for a deliberate run before real customers use the site.
ALLOW_REAL_DB_TESTS=0

# Optional
# NSIGNAGE_REGISTRATION=open        # 'closed' = only staff create accounts
# NSIGNAGE_SESSION_DAYS=30
# DATABASE_POOL_MAX=3

# QA / demo website logins (optional): QA_1_USERNAME, QA_1_PASSWORD, QA_1_RECOVERY_KEY, QA_2_…
